digraph States {
  graph [rankdir=TB, bgcolor="white", pad=.3, nodesep=.8, ranksep=1.1];
  node [shape=box, style="rounded,filled", fillcolor="#f5f7f9", color="#263746", fontname="Times New Roman", fontsize=20, margin=".22,.16"];
  edge [fontname="Times New Roman", fontsize=16, color="#263746", arrowsize=.8, penwidth=1.5];
  idle [label="idle\nneed_light = 0"];
  active [label="active\nneed_light = valid AND dark"];
  adjust [label="adjust\nneed_light = 0\nzero після 1 с стабільності"];
  idle -> active [label="PIR HIGH"];
  active -> active [label="кожен HIGH\nоновлює last_high"];
  active -> idle [label="age PIR HIGH\n≥30 с"];
  idle -> adjust [label="mode adjust"];
  active -> adjust [label="mode adjust"];
  adjust -> idle [label="mode auto\nскидання історії"];
}
